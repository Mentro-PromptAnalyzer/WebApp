{
  "enabled": true,
  "name": "Format on Agent Stop",
  "description": "Runs prettier on the saved file whenever a source file is edited",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "npx --prefix mentro prettier --write mentro/src",
    "timeout": 30
  },
  "workspaceFolderName": "Mentro",
  "shortName": "format-on-save"
}